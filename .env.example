# 至道选课自动化 - 环境配置模板
# 复制为 data/.env 使用（首次运行会自动生成带同样注释的模板）。
# 真实环境变量优先于文件值；本文件值仅在环境变量未设置时生效。
# 警告：data/.env 含真实密钥，已被 .gitignore 忽略，禁止提交进仓库。

# ---------- 必填 ----------
# 管理口令（缺失拒绝启动；随 data/ 一起备份迁移）
XUANKE_ADMIN_TOKEN=请改成你的口令

# ---------- 可选：管理员账号名 ----------
# 登录页账号填这个名字即进入管理后台；不设默认 admin
# XUANKE_ADMIN_NAME=admin

# ---------- 可选：验证码识别 ----------
# 识别引擎：ddddocr=本地离线免密钥（默认）；vision=OpenAI 兼容视觉 API（需填 SF_API_KEY）
# XUANKE_CAPTCHA_ENGINE=ddddocr
# OpenAI 兼容视觉 API 密钥（仅 vision 引擎需要）
# SF_API_KEY=
# 视觉 API 地址与模型（一般用默认即可，可改任意 OpenAI 兼容服务）
# SF_BASE_URL=https://api.siliconflow.cn/v1
# SF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# ---------- 可选：激活码机制 ----------
# on=启用（公网分发用，学生账号首次登录需激活码）；off/缺省=关闭（本地直接用）
# XUANKE_ACTIVATION=off

# ---------- 可选：数据加密主密钥 ----------
# 64 位 hex（32 字节）。不填则自动生成到 data/.master_key；与 db 一起备份迁移。
# 更换主密钥会导致已加密凭据不可读，慎重。
# XUANKE_MASTER_KEY=

# ---------- 可选：服务与存储 ----------
# XUANKE_PORT=3091
# XUANKE_DB=data/xuanke.db

# ---------- 可选：信任的反向代理 ----------
# 部署在可信反代后时设 on：信 X-Forwarded-For 最右值做 IP 限流。
# 默认关闭：绝不信公网伪造的 XFF。仅回环 RemoteAddr 会检查本开关。
# XUANKE_TRUSTED_PROXY=off
