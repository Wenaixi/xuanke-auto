          "content": {
            "size": 5200,
            "mimeType": "text/html",
            "text": "<div class=\"wrapper\" style=\"background-color: #ecf0f5;\">\n    <header class=\"main-header\" id=\"main_header\">\n        <a href=\"javascript:;\" lay-href=\"/desk\" class=\"logo\" style=\"padding-left:0px;padding-right: 0px;\">\n            <span class=\"logo-mini\"><img src=\"/public/images/logo.png\"></span>\n            <span class=\"logo-lg\"><img id=\"layoutAreaLogo\" src=\"/public/images/logo_lg1.png\"></span>\n        </a>\n        <nav class=\"navbar navbar-static-top\">\n            <a href=\"javascript:;\" class=\"sidebar-toggle\" data-toggle=\"offcanvas\" role=\"button\">\n                <span class=\"sr-only\">Toggle navigation</span>\n            </a>\n            <a href=\"javascript:;\" id=\"layoutDebugRefresh\" style=\"float: left;color: #fff;padding:15px;display: none;\">\n                <i class=\"fa fa-refresh\"></i>\n            </a>\n            <div class=\"navbar-custom-menu\">\n                <ul class=\"nav navbar-nav\">\n                    <li class=\"dropdown notifications-menu\">\n                        <a style=\"display: none\" id=\"NW_FEEDBACK_URL\" href=\"javascript:void(0)\" target=\"_blank\" title=\"问题反馈\">\n                            <i class=\"fa fa-product-hunt\"></i>\n                        </a>\n                    </li>\n\n                    <li class=\"dropdown user user-menu hidden-xs\" style=\"display: none\" id=\"layoutPasswordTip\">\n                        <a href=\"javascript:;\" lay-href=\"/user/changePassword\" title=\"密码过期\">\n                            <i class=\"glyphicon glyphicon-info-sign\" style=\"top: 3px\"></i>\n                            <span class=\"hidden-xs\">密码过期</span>\n                        </a>\n                    </li>\n\n                    <li class=\"dropdown user user-menu\">\n                        <a href=\"javascript:;\" lay-href=\"/user/profile\" title=\"我的账户基本信息\">\n                            <i class=\"fa fa-user\"></i>\n                            <span class=\"hidden-xs\" id=\"layoutUserName\">\n                        </span>\n                        </a>\n                    </li>\n\n                    <li id=\"layoutRunAsUser\" style=\"display: none\" class=\"dropdown user user-menu\">\n                        <a href=\"javascript:void(0)\" title=\"账户切换\">\n                            <i class=\"fa fa-list\"></i>\n                            <span class=\"hidden-xs\">账户切换</span>\n                        </a>\n                    </li>\n\n                    <li id=\"RUN_AS_MASTER_STUDENT\" style=\"display: none\" class=\"dropdown user user-menu\">\n                        <a href=\"javascript:void(0)\" title=\"切换学生账户\">\n                            <i class=\"fa fa-arrow-right\"></i>\n                            <span class=\"hidden-xs\">切换学生账户</span>\n                        </a>\n                    </li>\n\n                    <li id=\"FROM_SESSION_PRINCIPAL_KEY\" style=\"display: none\" class=\"dropdown user user-menu\">\n                        <a href=\"javascript:void(0)\" title=\"返回原账户\">\n                            <i class=\"fa fa-arrow-left\"></i>\n                            <span class=\"hidden-xs\">返回原账户</span>\n                        </a>\n                    </li>\n\n                    <li id=\"imWsUrl\" style=\"display: none\" class=\"dropdown user user-menu\">\n                        <a href=\"javascript:void(0)\" title=\"题目抢答\">\n                            <i class=\"fa fa-life-ring\"></i>\n                            <span class=\"hidden-xs\">题目抢答</span>\n                        </a>\n                    </li>\n\n                    <li class=\"dropdown\">\n                        <a id=\"layoutLogout\" href=\"javascript:void(0)\" title=\"注销\">\n                            <i class=\"fa fa-power-off\"></i>\n                            <span class=\"hidden-xs\" style=\"margin-left: 5px\">注销</span>\n                        </a>\n                    </li>\n                </ul>\n            </div>\n        </nav>\n    </header>\n\n    <style>\n        .sidebar-menu li {\n            line-height: 1.228571;\n        }\n    </style>\n\n    <aside class=\"main-sidebar\" style=\"background-color: #222d32;\">\n        <!-- sidebar: style can be found in sidebar.less -->\n        <section class=\"sidebar\" id=\"menu_sidebar\" style=\"overflow:auto\">\n            <div class=\"sidebar-form\">\n                <div class=\"input-group\">\n                    <input type=\"text\" id=\"searchMenuBarText\" class=\"form-control\" autocomplete=\"off\" placeholder=\"搜索菜单...\">\n                    <span class=\"input-group-btn\">\n                <button type=\"button\" id=\"searchMenuBarBtn\" class=\"btn btn-flat\"><i class=\"fa fa-search\"></i>\n                </button>\n              </span>\n                </div>\n            </div>\n            <!-- sidebar menu: : style can be found in sidebar.less -->\n            <ul class=\"sidebar-menu\" id=\"LAY-system-side-menu\">\n\n            </ul>\n        </section>\n        <!-- /.sidebar -->\n    </aside>\n\n    <div class=\"content-wrapper\" style=\"height:100%\">\n        <div id=\"LAY_app_body\"></div>\n    </div>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"/_views/onlineCourse/myStudyCourse/imWs.css\"/>\n<link rel=\"stylesheet\" href=\"/layui/css/layuiForChat.css\"/>\n\n<script>\n    layui.use([], function () {\n\n    });\n</script>"
