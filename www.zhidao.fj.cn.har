            "text": "<section class=\"content-header\">\n    <ol class=\"breadcrumb\">\n        <li><a href=\"javascript:;\"><i class=\"breadcrumb_icon\"></i>研究性学习</a></li>\n        <li class=\"active\">参考选题浏览</li>\n    </ol>\n</section>\n<section class=\"content\" style=\"margin-left:15px;margin-right:15px;\">\n    <div class=\"row\">\n        <div class=\"col-sm-12 box box-primary search-box-div-one\">\n            <div class=\"form-inline\">\n                <label class=\"control-label\">标题:</label>\n                <input type=\"text\" id=\"searchTitle\" maxlength=\"50\" class=\"form-control\" placeholder=\"根据选题标题搜索\">\n                <button id=\"btn_search\" class=\"btn btn-primary\">\n                    <i class=\"glyphicon glyphicon-search\"></i> 查询\n                </button>\n            </div>\n        </div>\n        <div class=\"col-sm-12 box box-primary\">\n            <table id=\"studyExampleTable\" style=\"white-space:nowrap; overflow:hidden\"></table>\n        </div>\n    </div>\n</section>\n\n<script type=\"text/html\" id=\"contentViewPopup\">\n    <div class=\"popdiv\" style=\"width:100%; padding:30px\" id=\"contentView\">\n    </div>\n</script>\n<script>\n    layui.use([], function () {\n        const path = exportViewPath();\n        layui.use(path, layui.factory(path));\n    });\n</script>"
