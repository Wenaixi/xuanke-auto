            "mimeType": "text/html",
            "text": "<section class=\"content-header\">\n    <ol class=\"breadcrumb\">\n        &nbsp;\n    </ol>\n</section>\n\n<section class=\"content\" style=\"margin-left:15px; margin-right:15px;\">\n    <div class=\"row\">\n        <div class=\"col-sm-12 box box-primary search-box\">\n            <div class=\"form-inline\">\n                <div class=\"search-item\">\n                    <label class=\"control-label\">年级：</label>\n                    <select id=\"gradeId\" class=\"form-control\">\n                        <option value=\"\">全部</option>\n                    </select>\n                </div>\n                <div class=\"search-item\" style=\"width: 190px\">\n                    <label class=\"control-label\">学年学期：</label>\n                    <select id=\"yearTermId\" class=\"form-control\">\n                        <option value=\"\">全部</option>\n                    </select>\n                </div>\n                <div class=\"search-item\">\n                    <label class=\"control-label\">课题名称：</label>\n                    <input type=\"text\" id=\"studyTitle\" maxlength=\"50\" class=\"form-control\" placeholder=\"课题名称\">\n                </div>\n                <div class=\"search-item\">\n                    <label class=\"control-label\">学生姓名：</label>\n                    <input type=\"text\" id=\"studyStuName\" maxlength=\"50\" class=\"form-control\" placeholder=\"学生姓名\">\n                </div>\n                <div class=\"search-item\">\n                    <label class=\"control-label\">指导老师：</label>\n                    <input type=\"text\" id=\"studyTeacherName\" maxlength=\"50\" class=\"form-control\" placeholder=\"指导老师姓名\">\n                </div>\n                <div class=\"search-btn-item\">\n                    <a id=\"btn_search_study\" class=\"btn btn-primary\">\n                        <i class=\"glyphicon glyphicon-search\"></i> 查询\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"col-sm-12 box box-primary\">\n            <table id=\"studyProjectsTable\" style=\"white-space:nowrap; overflow:hidden\"></table>\n        </div>\n    </div>\n</section>\n\n<script>\n    layui.use([], function () {\n        const path = exportViewPath();\n        layui.use(path, layui.factory(path));\n    });\n</script>"
