            "text": "<!-- 主页内容开始 -->\n<section class=\"content userDesk\" style=\"margin-top:0;height: 100%;padding: 12px 18px 0 18px;display: none\">\n    <style>\n        .notepad-content {\n            overflow: auto;\n            height: 305px;\n        }\n\n        .notepad-content:hover::-webkit-scrollbar-thumb {\n            background-color: rgba(0, 0, 0, 0.20);\n        }\n\n        .notepad-content::-webkit-scrollbar-thumb {\n            background-color: #fff;\n        }\n\n        .notepad-content::-webkit-scrollbar {\n            width: 3px;\n            background-color: #fff;\n        }\n\n        #deskCountDivParent {\n            overflow: auto;\n            height: 320px;\n        }\n\n        #deskCountDivParent:hover::-webkit-scrollbar-thumb {\n            background-color: rgba(0, 0, 0, 0.20);\n        }\n\n        #deskCountDivParent::-webkit-scrollbar-thumb {\n            background-color: #fff;\n        }\n\n        #deskCountDivParent::-webkit-scrollbar {\n            width: 3px;\n            background-color: #fff;\n        }\n\n        .notepad-content .readNotepad:hover {\n            background-color: #edf3fe !important\n        }\n\n        .slider-group {\n            padding: 0 10px;\n        }\n\n        @font-face {\n            font-family: 'layui-icon';\n            src: url('/layui/font/iconfont.eot?v=256');\n            src: url('/layui/font/iconfont.eot?v=256#iefix') format('embedded-opentype'),\n            url('/layui/font/iconfont.woff2?v=256') format('woff2'),\n            url('/layui/font/iconfont.woff?v=256') format('woff'),\n            url('/layui/font/iconfont.ttf?v=256') format('truetype'),\n            url('/layui/font/iconfont.svg?v=256#layui-icon') format('svg');\n        }\n\n        .layui-icon {\n            font-family: \"layui-icon\" !important;\n            font-size: 16px;\n            font-style: normal;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        .layui-laydate-static {\n            height: 100%;\n            width: 100% !important;\n            overflow: auto;\n            border-radius: 5px;\n            border: 0 !important;\n            box-shadow: none !important;\n        }\n\n        .layui-laydate-static > .layui-laydate-main {\n            width: 100% !important;\n        }\n\n        .layui-laydate-static .layui-laydate-header {\n            line-height: 25px !important;\n        }\n\n        .layui-laydate-static .layui-laydate-content > table {\n            width: 100% !important;\n        }\n\n        .layui-laydate-static .layui-laydate-content table > thead,\n        .layui-laydate-static .layui-laydate-content table > tbody,\n        .layui-laydate-static .layui-laydate-content td {\n            border: 0 !important;\n        }\n\n        .layui-laydate-static .layui-laydate-content td {\n            height: 39px !important;\n        }\n\n        .my-data-div {\n            height: 60px;\n            padding: 3px;\n            width: 20%;\n            float: left;\n        }\n\n        .my-data {\n            width: 100%;\n            position: absolute;\n            top: 35px;\n            bottom: 20px;\n            left: 0px;\n            padding: 20px 20px 0px 20px;\n            overflow-x: auto;\n            display: grid;\n            justify-items: center;\n            align-items: center;\n            grid-template-columns: 1fr 1fr 1fr;\n            grid-template-rows: 1fr 1fr 1fr;\n            grid-gap: 20px;\n        }\n\n        .my-data > a {\n            display: block;\n            width: 100%;\n            height: 100%;\n        }\n\n        .my-data-item {\n            text-align: center;\n            vertical-align: middle;\n            flex-direction: column;\n            justify-content: center;\n            align-items: flex-start;\n            width: 100%;\n            height: calc(100%);\n            min-height: 40px;\n            background-color: #f6f6f6;\n            border-radius: 5px;\n        }\n\n        .my-data-item > div:nth-child(1) {\n            font-size: 23px !important;\n            color: #479ff7 !important;\n        }\n\n        .my-data-item > div:nth-child(2) {\n            font-size: 13px !important;\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: ellipsis;\n        }\n\n        #noticeListDiv td {\n            padding: 5px;\n        }\n\n        #deskLinkDiv {\n            height: auto !important;\n        }\n\n        #deskLinkDiv .swiper-slide {\n            padding: 4px 0 !important;\n            margin-top: 5px !important;\n            text-align: center;\n            font-size: 18px;\n            background: #fff;\n            width: 118px;\n            display: -webkit-box;\n            display: -ms-flexbox;\n            display: -webkit-flex;\n            display: flex;\n            flex-direction: column;\n            -webkit-box-pack: center;\n            -ms-flex-pack: center;\n            -webkit-justify-content: center;\n            justify-content: space-between;\n            -webkit-box-align: center;\n            -ms-flex-align: center;\n            -webkit-align-items: center;\n            align-items: center;\n        }\n\n        #deskLinkDiv .swiper-slide > a > div {\n            height: 60px;\n        }\n\n        .main-content-title li {\n            line-height: 30px;\n            height: 30px;\n            display: flex;\n            align-items: center;\n        }\n\n        .main-content-title li a {\n            color: #333333;\n            padding-left: 5px;\n            padding-right: 5px;\n            flex: 1;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            white-space: nowrap;\n            font-size: 14px;\n            margin-left: 6px;\n        }\n\n        .main-content-title a {\n            text-decoration: none;\n        }\n\n        .main-content-title li .date {\n            color: #666666;\n            font-size: 14px;\n        }\n\n        .main-content-title li a:hover {\n            text-decoration: underline;\n        }\n\n        .main-content-title li:hover {\n            background-color: #edf3fe !important\n        }\n\n        .main-content-title a:hover {\n            color: #086CBE !important;\n        }\n\n        .main-content-title .list-mark {\n            height: 5px;\n            width: 5px;\n            background-color: #3285FF;\n            transform: rotate(45deg);\n            flex: 0 0 5px;\n            margin-left: 5px;\n        }\n\n        #notepadListDiv tr:hover {\n            background-color: #edf3fe !important\n        }\n    </style>\n    <div class=\"row\" style=\"height:calc(100%);min-height: 265px;overflow: auto\">\n        <!-- 常用功能模块 -->\n        <div class=\"col-md-7 padding-left-10\" id=\"deskLinkMdDiv\" style=\"height:381px\">\n            <div class=\"box box-primary\" style=\"margin-bottom:0px;height:100%\">\n                <div class=\"box-header with-border slider-group\">\n                    <ul id=\"deskLinkTabDiv\" style=\"margin-bottom:0\">\n                        <li class=\"group-btn\"><span></span></li>\n                    </ul>\n                </div>\n                <div class=\"box-body padding-all-5 swiper-content flex\">\n                    <div class=\"swiper-container\">\n                        <div id=\"deskLinkDiv\" class=\"swiper-wrapper\" style=\"display: none;\">\n                        </div>\n                        <div class=\"swiper-pagination\" style=\"bottom: 0;\"></div>\n                    </div>\n                    <!-- 无数据时取消注释 -->\n                    <div id=\"noLinkMsg\" class=\"no-data\" style=\"display: none;\">\n                        <img src=\"/public/assets/i/noData.png\" style=\"height: 40%;\"/>\n                        <span>当前暂无快捷方式！</span>\n                    </div>\n                </div>\n                <div class=\"overlay\" id=\"deskLinkRefresh\">\n                    <i class=\"fa fa-spinner fa-spin\" style=\"color: gray;\"></i>\n                </div>\n            </div>\n        </div>\n        <!-- 我的数据模块 -->\n        <div class=\"col-md-5  padding-right-10\" style=\"height:381px; padding-left: 6px;\" id=\"deskCountMdDiv\">\n            <div class=\"box box-primary\" style=\"margin-bottom:0px; height:100%;position: relative\">\n                <div class=\"box-header with-border\" style=\"padding: 12px 0 8px 10px;\">\n                    <h3 class=\"box-title\" style=\"font-size: 17px;\">校务提醒</h3>\n                    <h3 class=\"box-title dateSmsExpirationTip\" style=\"font-size: 12px;color: red;\"></h3>\n                    <div class=\"box-tools pull-right\">\n                        <button type=\"button\" class=\"btn btn-box-tool\" id=\"refreshCountBtn\" title=\"刷新\">\n                            <i class=\"glyphicon glyphicon-refresh\"></i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"box-body\" style=\"overflow-x:auto;max-height: 320px\" id=\"deskCountDivParent\">\n                    <div class=\"col-md-12 column\" id=\"deskCountDiv\" style=\"padding: 0;\">\n\n                    </div>\n                </div>\n                <div class=\"overlay\" id=\"deskCountRefresh\" style=\"display: none\">\n                    <i class=\"fa fa-spinner fa-spin\" style=\"color: gray;\"></i>\n                </div>\n            </div>\n        </div>\n        <!-- 公示公告模块 -->\n        <div class=\"col-md-4 padding-left-10\" style=\"height:381px; padding-right: 9px;\">\n            <div class=\"box box-primary\" style=\"margin-bottom:0px;height:100%\">\n                <div class=\"box-header with-border\" style=\"padding: 12px 0 8px 10px;\">\n                    <h3 class=\"box-title\" style=\"font-size: 17px;\">公示公告</h3>\n                    <div class=\"box-tools pull-right\" style=\"top: 7px;\">\n                        <button type=\"button\" class=\"btn btn-box-tool boxtoolbtn\">\n                            <a href=\"/admin.html#/notice/query\">更多</a>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"box-body notepad-content\" style=\"height: 330px\">\n                    <ul id=\"noticeListDiv\" class=\"main-content-title hasNotice\">\n                    </ul>\n                    <div id=\"noNoticeMsg\" class=\"no-data notHasNotice\">\n                        <img src=\"/public/assets/i/noData.png\" style=\"height: 40%;\"/>\n                        <span>当前暂无公示公告内容！</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- 日历模块 -->\n        <div class=\"col-md-4 padding-center-10\" style=\"height:381px;padding-left: 12px;padding-right: 12px;\">\n            <div class=\"box box-primary\" style=\"margin-bottom:0px;height:100%\">\n                <div class=\"box-body padding-all-5\" id=\"scheduleDiv\" style=\"display: none\">\n                    <div class=\"schedule\"></div>\n                </div>\n                <div id=\"articleDiv\" style=\"display: none\">\n                    <div class=\"box-header with-border\" style=\"padding: 12px 0 8px 10px;\">\n                        <h3 class=\"box-title\" style=\"font-size: 17px;\">官网发布</h3>\n                        <div class=\"box-tools pull-right\" style=\"top: 7px;\">\n                            <button type=\"button\" class=\"btn btn-box-tool boxtoolbtn\">\n                                <a id=\"moreArticle\" target=\"_blank\">更多</a>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"box-body notepad-content\" style=\"height: 330px\">\n                        <ul id=\"articleListDiv\" class=\"main-content-title hasArticle\">\n                        </ul>\n                        <div id=\"noArticleMsg\" class=\"no-data notHasArticle\">\n                            <img src=\"/public/assets/i/noData.png\" style=\"height: 40%;\"/>\n                            <span>当前暂无资讯！</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- 备忘记录模块 -->\n        <div class=\"col-md-4 padding-right-10\" style=\"height:381px; padding-left: 9px;\">\n            <div class=\"box box-primary\" style=\"margin-bottom:0px;height:100%\">\n                <div class=\"box-header with-border\" style=\"padding: 12px 0 8px 10px;\">\n                    <h3 class=\"box-title\" style=\"font-size: 17px;\">备忘记录</h3>\n                    <div class=\"box-tools pull-right\" style=\"top: 7px;\">\n                        <button type=\"button\" class=\"btn btn-box-tool boxtoolbtn\">\n                            <a href=\"javascript:;\" id=\"addNotepadBtn\">添加</a>\n                        </button>\n                        <button type=\"button\" class=\"btn btn-box-tool boxtoolbtn\">\n                            <a href=\"javascript:;\" id=\"viewAllNotepadBtn\">更多</a>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"box-body notepad-content\">\n                    <div id=\"noNotepadMsg\" class=\"no-data\">\n                        <img src=\"/public/assets/i/noData.png\" style=\"height: 40%;\"/>\n                        <span>当前暂无备忘记录！</span>\n                    </div>\n                    <table id=\"notepadListDiv\" class=\"table table-condensed table-hover de***REMOVED***\" style=\"width: 100%;display: none;table-layout:fixed;\">\n                    </table>\n                </div>\n                <div class=\"overlay\" id=\"deskNotepadRefresh\">\n                    <i class=\"fa fa-spinner fa-spin\" style=\"color: gray;\"></i>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n\n<!-- 主页内容结束 -->\n<section class=\"content adminDesk\" id=\"deskDiv\" style=\"display: none\">\n    <div class=\"row\">\n        <div class=\"col-md-6\" style=\"padding-right: 10px;\">\n            <div class=\"box box-primary\" style=\"margin-bottom: 20px;\">\n                <div class=\"box-header with-border\" style=\"position: relative;\">\n                    <i class=\"fa fa-pie-chart\"></i>\n                    <h3 class=\"box-title\">\n                        <span>系统平台概要</span>\n                        <button id=\"lookAtSystemTask\" class=\"btn btn-primary btn-xs\">查看后台运行任务</button>\n                    </h3>\n                    <h3 class=\"box-title dateSmsExpirationTip\" style=\"color: red;position: absolute;right:12px;font-size: 15px;\"></h3>\n                </div>\n                <div class=\"box-body\">\n                    <div class=\"chart\">\n                        <div class=\"col-md-4 column setHeight\" id=\"areaInfoContent\"></div>\n                        <div class=\"col-md-4 column setHeight\" id=\"userInfoContent\"></div>\n                        <div class=\"col-md-4 column setHeight\" id=\"loginInfoContent\"></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"box box-info\">\n                <div class=\"box-header with-border\">\n                    <i class=\"fa fa-tachometer\"></i>\n                    <h3 class=\"box-title\">系统硬件使用情况</h3>\n                </div>\n                <div class=\"box-body\">\n                    <div class=\"chart\">\n                        <div class=\"col-md-6 column setHeight\" id=\"memoryInfoContent\"></div>\n                        <div class=\"col-md-6 column setHeight\" id=\"cpuInfoContent\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"col-md-6\" style=\"padding-left: 10px;\">\n            <div class=\"box box-danger\" style=\"margin-bottom: 20px;\">\n                <div class=\"box-header with-border\">\n                    <i class=\"fa fa-bar-chart-o\"></i>\n                    <h3 class=\"box-title\">系统办公事务数汇总</h3>\n                </div>\n                <div class=\"box-body\">\n                    <div class=\"chart\">\n                        <div id=\"workContent\" class=\"col-md-12 column setHeight\"></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"box box-success\">\n                <div class=\"box-header with-border\">\n                    <i class=\"fa fa-object-group\"></i>\n                    <h3 class=\"box-title\">系统拓扑图</h3>\n                </div>\n                <div class=\"box-body\">\n                    <div class=\"chart\" id=\"showBigImage\" style=\"cursor: pointer\">\n                        <div id=\"barChart\" class=\"col-md-12 column setHeight\"\n                             style=\"background:url('/public/beforeimg/beforepic/systemInfo.png');background-size: 100%;background-repeat: no-repeat; background-attachment: scroll;background-position: center;width: 90%\"\n                        ></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<div id=\"cozeAgentEntry\" style=\"position: absolute;bottom: 50px;right: 30px; cursor: pointer\"></div>\n<!--数据填报内容弹框按日期(月，周，日)-->\n<script type=\"text/html\" id=\"contentStatusBySchool\">\n    <div id=\"outContent\" style=\"padding: 0 15px\" class=\"search-box\">\n        <div id=\"schoolStatusToolbar\">\n            <div class=\"form-inline\">\n                <div class=\"search-item\" style=\"width: 110px;\">\n                    <label class=\"control-label\">对象类型:</label>\n                    <select id=\"relate_type_condition\" class=\"form-control\">\n                    </select>\n                </div>\n                <div class=\"search-item\" style=\"width: 130px;\">\n                    <label class=\"control-label\">对象名称:</label>\n                    <input type=\"text\" id=\"search_name_school\" class=\"form-control\" style=\"width: 130px\" maxlength=\"15\" placeholder=\"输入对象名称\">\n                </div>\n                <div class=\"search-item\" style=\"width: 110px;\">\n                    <label class=\"control-label\">提交状态:</label>\n                    <select id=\"school_status\" class=\"form-control\">\n                        <option value=\"\">全部</option>\n                    </select>\n                </div>\n                <div class=\"search-item\" id=\"schoolDaySpan\" style=\"display: none; width: 110px;\">\n                    <label class=\"control-label\">按日选择:</label>\n                    <input type=\"text\" id=\"daySchool\" class=\"form-control\" readonly=\"readonly\" placeholder=\"选择日期\">\n                </div>\n                <div class=\"search-item\" id=\"schoolMonthSpan\" style=\"display: none; width: 110px;\">\n                    <label class=\"control-label\">按月选择:</label>\n                    <input type=\"text\" id=\"monthSchool\" class=\"form-control\" readonly=\"readonly\" placeholder=\"选择月份\">\n                </div>\n                <div class=\"search-item\" id=\"schoolWeekSpan\" style=\"display: none; width: 110px;\">\n                    <label class=\"control-label\">按周选择:</label>\n                    <select id=\"weekSchool\" class=\"form-control\" placeholder=\"选择周期\"></select>\n                </div>\n                <div class=\"search-item\" id=\"schoolTermSpan\" style=\"display: none\">\n                    <label class=\"control-label\">选择学期:</label>\n                    <select id=\"term_search\" class=\"form-control\"></select>\n                </div>\n                <div class=\"search-item\" id=\"schoolYearSpan\" style=\"display: none\">\n                    <label class=\"control-label\">选择学年:</label>\n                    <input type=\"text\" id=\"yearSchool\" class=\"form-control\" readonly=\"readonly\" placeholder=\"选择学年\">\n                </div>\n\n                <span id=\"grade_span\">\n                <div class=\"search-item\" style=\"width: 110px;\">\n                    <label class=\"control-label\">选择年级:</label>\n                    <select id=\"grade_condition\" class=\"form-control\">\n                        <option value=\"\">全部</option>\n                    </select>\n                </div>\n                <div class=\"search-item\" style=\"width: 110px;\">\n                    <label class=\"control-label\">选择班级:</label>\n                    <select id=\"class_condition\" class=\"form-control\">\n                        <option value=\"\">全部</option>\n                    </select>\n                </div>\n                </span>\n                <div class=\"search-btn-item\">\n                    <button id=\"schoolBtn\" class=\"btn btn-primary\"><i class=\"glyphicon glyphicon-search\"></i> 查询</button>\n                </div>\n                <div class=\"search-btn-item\">\n                    <button id=\"batchSendMessage\" class=\"btn btn-warning\" disabled><i class=\"glyphicon glyphicon-envelope\"></i> 批量发送通知</button>\n                </div>\n                <div class=\"search-btn-item\">\n                    <button id=\"batchSendMessageAll\" class=\"btn btn-warning\"><i class=\"glyphicon glyphicon-envelope\"></i> 催填未提交</button>\n                </div>\n                <div id=\"chartBtnDiv\" class=\"search-btn-item\">\n                    <button id=\"chartBtn\" class=\"btn btn-success\"><i class=\"glyphicon glyphicon-stats\"></i> 完成度</button>\n                </div>\n                <span class=\"ml-5\" id=\"completionDiv\"></span>\n            </div>\n        </div>\n        <div class=\"col-sm-12\">\n            <table id=\"schoolContentStatusTable\" style=\"white-space:nowrap; overflow:hidden\"></table>\n\n        </div>\n    </div>\n</script>\n\n\n<script type=\"text/html\" id=\"sendSmsPopup\">\n    <form role=\"form\">\n        <div class=\"box-body form-popup\">\n            <div class=\"row\">\n                <div class=\"col-md-12\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">短信内容:</label>\n                        <textarea id=\"editMsg\" style=\"min-height: 75px;\" class=\"form-control\" placeholder=\"短信内容至多100个字\" maxlength=\"100\"></textarea>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </form>\n</script>\n\n<script type=\"text/html\" id=\"sendSmsToAllPopup\">\n    <form role=\"form\">\n        <div class=\"box-body form-popup\">\n            <div class=\"row\">\n                <div class=\"col-md-12\" id=\"nameDiv\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">人员名单<i class=\"required-sign\">*</i></label>\n                        <textarea id=\"sendObjectNames\" style=\"min-height: 300px;\" class=\"form-control\" placeholder=\"\" readonly></textarea>\n                    </div>\n                </div>\n                <div class=\"col-md-12\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">短信内容<i class=\"required-sign\">*</i><span\n                                style=\"color: red;font-weight: 500;\">（如需在短信内容中添加网页填写链接，请使用 ### 代替链接位置，填写人收到短信可直接点击链接打开单独的页面进行填报）</span></label>\n                        <textarea id=\"editMsgAll\" style=\"min-height: 130px;\" class=\"form-control\" placeholder=\"短信内容至多500个字\" maxlength=\"500\"></textarea>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </form>\n</script>\n<script>\n    layui.use([], function () {\n        const path = exportViewPath();\n        layui.use(path, layui.factory(path));\n    });\n</script>"
          },
