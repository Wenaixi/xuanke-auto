            "size": 1561,
            "mimeType": "text/html",
            "text": "<section class=\"content-header\">\n    <ol class=\"breadcrumb\">\n        <li><a href=\"javascript:;\"><i class=\"breadcrumb_icon\"></i>研究性学习</a></li>\n        <li class=\"active\">我的研究性学习</li>\n    </ol>\n</section>\n\n<section class=\"content\" style=\"margin-left:15px;margin-right:15px;\">\n    <div class=\"row\">\n        <div class=\"col-sm-12 box box-primary search-box-div-one\">\n            <div class=\"form-inline\">\n                <label class=\"control-label\">学期:</label>\n                <select id=\"yearTermId\" class=\"form-control\">\n                    <option value=\"\">全部</option>\n                </select>\n                <label class=\"control-label ml-5\">课题状态:</label>\n                <select id=\"statusId\" class=\"form-control\">\n                    <option value=\"\">全部</option>\n                </select>\n                <label class=\"control-label ml-5\">研究状态:</label>\n                <select id=\"studyStatusId\" class=\"form-control\">\n                    <option value=\"\">全部</option>\n                </select>\n                <a id=\"btn_search_study\" class=\"btn btn-primary\">\n                    <i class=\"glyphicon glyphicon-search\"></i> 查询\n                </a>\n            </div>\n        </div>\n        <div class=\"col-sm-12 box box-primary\">\n            <table id=\"studyTable\" style=\"white-space:nowrap; overflow:hidden\"></table>\n        </div>\n    </div>\n</section>\n<script>\n    layui.use([], function () {\n        const path = exportViewPath();\n        layui.use(path, layui.factory(path));\n    });\n</script>"
          },
