            "text": ".imWsContent{height:100%;width:100%}.imWsContent .leftContent{width:250px;height:100%;float:left;padding:10px 0 10px 10px}.imWsContent .leftContent .selfContent{height:52px;overflow:hidden;background-color:#d4e9fb}.imWsContent .leftContent .userContent{height:55%;overflow:auto;background-color:rgba(0,0,0,.05)}.imWsContent .leftContent .userContent::-webkit-scrollbar{width:2px;height:2px}.imWsContent .leftContent .msgContent{margin-top:10px;height:calc(45% - 62px);overflow:auto;background-color:#d4e9fb;padding:5px}.imWsContent .leftContent .msgContent .msgInfoContent{height:calc(100% - 34px);overflow:auto}.imWsContent .leftContent .msgContent .msgInfoContent::-webkit-scrollbar{width:2px;height:2px}.imWsContent .leftContent .msgContent .msgSendContent{height:34px;background:#fff}.imWsContent .leftContent .msgContent .msgSendContent input{width:calc(100% - 50px);float:left}.imWsContent .leftContent .msgContent .msgSendContent .sendMsgBtn{width:50px;height:100%;float:left;padding:6px}.imWsContent .leftContent .msgContent p{margin:0 0 5px;padding-left:5px;word-break:break-all}.imWsContent .leftContent .msgContent::-webkit-scrollbar{width:1px;height:2px}.imWsContent .rightContent{height:100%;width:calc(100% - 250px);float:left;position:relative;padding:10px}.rightContent{zoom:1}.pkQuestionCover{height:100%}.pkQuestionCover .groupTitle{text-shadow:1px 1px #fff;width:100%;height:50px;text-align:center;font-size:24px;padding:10px;font-weight:700;color:#333;background-color:#3c8dbc;line-height:1.5}.pkQuestionCover .groupTitle .titlePanel{width:auto;background:#fff;opacity:.5}.pkQuestionCover .groupList{height:calc(100% - 120px);width:100%;position:relative;background-color:#3c8dbc}.pkQuestionCover .startTime{color:#fff;display:none;position:absolute;top:45%;text-align:center;width:calc(100% - 20px);font-size:20px;font-weight:700}.pkQuestionCover .groupList .pkSeat{text-align:center;width:100px;height:100px}.pkQuestionCover .groupList .pkSeat img{height:50%;border-radius:50px}.pkQuestionCover .groupList .pkSeat .btn{width:100%;height:50px;white-space:unset;margin-top:10px;background:radial-gradient(black,transparent);border-color:#45a1f7;color:#45a1f7;cursor:auto;align-items:center;display:flex;padding:0 2px}.pkQuestionCover .groupList .pkSeat .btn a{display:-webkit-box;width:100%;overflow:hidden;text-overflow:ellipsis;-webkit-line-clamp:2;-webkit-box-orient:vertical;word-break:break-all;margin:0}.wsAnswerBtnContent{padding-right:10px;position:absolute;bottom:0;left:10px;right:0;height:50px;text-align:center}.wsAnswerBtn span,.wsExitBtn span{letter-spacing:10px;padding-left:10px}.pkQuestionContent{height:100%;display:none}.pkQuestionContent .pkQuestionContentHeader{height:20%}.pkQuestionContent .pkQuestionContentHeader .leftHeader{width:25%;background-color:#d0d9ff;height:100%;padding:10px;float:left;justify-content:center;line-height:85px;font-weight:700;border-right:1px solid #fff;display:flex;align-items:center;font-size:30px;color:#333}.pkQuestionContent .pkQuestionContentHeader .rightHeader{width:75%;background-color:#b0bfff;height:100%;padding:10px;display:flex;flex-wrap:wrap;align-items:center}.pkQuestionContent .pkQuestionContentHeader .rightHeader .progressUserBar{width:50%;overflow:hidden;padding:1px 0}.pkQuestionContent .pkQuestionContentHeader .rightHeader .progressUserBar span{width:70px;float:left;text-overflow:ellipsis;overflow:hidden;align-items:center;display:flex;padding:0 5px;height:100%}.pkQuestionContent .pkQuestionContentHeader .rightHeader .progressUserBar .progressBarBorder{width:calc(100% - 70px);background-color:#9faeef;float:left;height:100%;transition:background-color .5s}.pkQuestionContent .pkQuestionContentHeader .rightHeader .progressUserBar .progressBar{width:0;background-color:#788cdb;height:100%;border-radius:3px}.pkQuestionContent .answerContainer{height:80%}.pkQuestionComplete{height:100%;display:none}.pkQuestionComplete .completeContainer{height:75%}"
