          "content": {
            "size": 27986,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n    <meta name=\"renderer\" content=\"webkit\">\n    <meta charset=\"UTF-8\"/>\n    <title>至道智慧校园ERP系统</title>\n    <meta name=\"keywords\" content=\"至道智慧校园ERP系统\"/>\n    <meta name=\"description\" content=\"至道智慧校园ERP系统\"/>\n    <link rel=\"stylesheet\" href=\"/lib/AdminLTE/dist/css/font-awesome.min.css\" type=\"text/css\"/>\n    <link rel=\"stylesheet\" href=\"/public/login_20200101/css/css.css?v=4\"/>\n    <link rel=\"stylesheet\" href=\"/lib/lunbo/css/lunbo.css\"/>\n</head>\n\n<body>\n<div class=\"zd-background\"\n>\n    <div class=\"zd-header\">\n        <div class=\"zd-logo\">\n            <img src=\"/public/login_20200101/images/logo.png\"/>\n        </div>\n    </div>\n    <div class=\"zd-main\">\n        <div class=\"zd-main-left\">\n            <!-- Swiper 轮播-->\n            <div class=\"swiper-container\">\n                <div class=\"swiper-wrapper\">\n                    <div class=\"swiper-slide\">\n                        <img src=\"/public/login_20200101/images/lunbo/lunbo1.jpg\" alt=\"\"/>\n                    </div>\n                    <div class=\"swiper-slide\">\n                        <img src=\"/public/login_20200101/images/lunbo/lunbo2.png\" alt=\"\"/>\n                    </div>\n                    <div class=\"swiper-slide\">\n                        <img src=\"/public/login_20200101/images/lunbo/lunbo3.png\" alt=\"\"/>\n                    </div>\n\n                </div>\n                <!-- Add Pagination -->\n                <div class=\"swiper-pagination\"></div>\n            </div>\n            <div class=\"zd-main-bottom\">\n                <div>\n                    <div class=\"icon\" id=\"huawei_icon\">\n                        <img id=\"pc\" src=\"/public/login_20200101/images/huawei.png\" alt=\"\"/>\n                        <span>华为安卓</span>\n                    </div>\n                </div>\n                <div>\n                    <div class=\"icon\" id=\"ohos_icon\">\n                        <img id=\"pc\" src=\"/public/login_20200101/images/huawei.png\" alt=\"\"/>\n                        <span>华为鸿蒙</span>\n                    </div>\n                </div>\n                <div id=\"android_box\">\n                    <div class=\"icon\" id=\"android_icon\">\n                        <img id=\"android\" src=\"/public/login_20200101/images/android_icon.png\" alt=\"\"/>\n                        <span>安卓版</span>\n                    </div>\n                    <!--<div class=\"code\">\n                        <img style=\"width:90px;height:90px\" src=\"/apkQrcode\"/>\n                    </div>-->\n                </div>\n                <div id=\"ios_box\">\n                    <div class=\"icon\" id=\"ios_icon\">\n                        <img id=\"ios\" src=\"/public/login_20200101/images/ios_icon.png\" alt=\"\"/>\n                        <span>iPhone版</span>\n                    </div>\n                    <!--<div class=\"code\">\n                        <img style=\"width:90px;height:90px\" src=\"/public/login_20200101/images/ios_code.png\"/>\n                    </div>-->\n                </div>\n                <div id=\"wx_box\">\n                    <div class=\"icon\" id=\"wx_icon\">\n                        <img id=\"wx\" src=\"/public/login_20200101/images/4.png\" alt=\"\"/>\n                        <span>微官网</span>\n                    </div>\n                    <!--<div class=\"code\">\n                        <img style=\"width:90px;height:90px\" src=\"/wcQrcode\"/>\n                    </div>-->\n                </div>\n            </div>\n        </div>\n        <!-- 用户名 -->\n        <div class=\"zd-main-right\">\n            <div class=\"right-text\">\n                <img src=\"/public/login_20200101/images/text.png\" alt=\"\"/>\n            </div>\n            <!-- 登录方式切换标签 -->\n            <div class=\"login-from\">\n                <div class=\"login-tabs\">\n                    <div class=\"login-tab active\" data-tab=\"account\">密码登录</div>\n                    <div class=\"login-tab\" data-tab=\"qrcode\">扫码登录</div>\n                </div>\n\n                <!-- 账号密码登录面板（默认显示） -->\n                <div class=\"login-panel active\" id=\"account-panel\">\n                    <div class=\"am-input-group input-btns\">\n                        <input id=\"userName\" name=\"userName\" type=\"text\" class=\"am-form-field\" placeholder=\"请输入账号\" autocomplete=\"off\"/>\n                        <span class=\"clear-text clearText\"><i class=\"fa fa-remove\"></i></span>\n                    </div>\n                    <div class=\"am-input-group input-btns\">\n                        <input id=\"password\" name=\"password\" type=\"password\" class=\"am-form-field\" placeholder=\"请输入密码\" autocomplete=\"off\"/>\n                        <span id=\"viewPassword\" class=\"pwd-icon\"><i class=\"fa fa-eye-slash\"></i></span>\n                        <span class=\"clear-text clearText\"><i class=\"fa fa-remove\"></i></span>\n                    </div>\n                    <div class=\"am-input-group\">\n                        <!-- 验证码 -->\n                        <input id=\"captcha\" type=\"text\" class=\"am-form-field\" placeholder=\"请输入验证码\" autocomplete=\"off\" style=\"border-radius: 18px 0 0 18px;\"/>\n                        <div class=\"check-code\" title=\"换一个？\">\n                            <img src=\"/login/captcha\" alt=\"\" onclick=\"updateCaptcha();\" class=\"zd-captcha\">\n                        </div>\n                    </div>\n                    <div class=\"submit-box\">\n                        <button id=\"btnLoginId\" type=\"button\">登录</button>\n                    </div>\n                    <!-- 底部链接 - 保留原图样式，优化为切换入口 -->\n                    <div class=\"am-input-group\" style=\"padding-bottom: 0;height: 28px !important;\">\n                        <a href=\"/admin.html#/login/forgetPassword\" class=\"zd-forget-pwd\">忘记密码?</a>\n                    </div>\n                </div>\n\n                <!-- 手机验证码登录面板 -->\n                <div class=\"login-panel\" id=\"sms-panel\">\n                    <div class=\"am-input-group input-btns\">\n                        <input id=\"userMobile\" name=\"userMobile\" type=\"text\" class=\"am-form-field\" placeholder=\"请输入手机号\" maxlength=\"11\" autocomplete=\"off\"/>\n                        <span class=\"clear-text clearText\"><i class=\"fa fa-remove\"></i></span>\n                    </div>\n                    <div class=\"am-input-group input-btns\">\n                        <input type=\"text\" class=\"am-form-field send-code-input\" id=\"userMobileCode\" placeholder=\"请输入验证码\" maxlength=\"6\" autocomplete=\"off\">\n                        <button class=\"send-code-btn\" id=\"sendCodeBtn\">获取验证码</button>\n                    </div>\n                    <div class=\"submit-box\">\n                        <button id=\"btnSmsLoginId\" type=\"button\">登录</button>\n                    </div>\n                </div>\n\n                <!-- APP扫码登录面板 -->\n                <div class=\"login-panel\" id=\"qrcode-panel\">\n                    <div class=\"qrcode-area\">\n                        <div class=\"qrcode-img\">\n                            <!-- 实际项目中替换为真实二维码 -->\n                            <img id=\"loginQrCode\" src=\"\" alt=\"APP扫码登录\" style=\"width: 100%; height: 100%;\">\n                        </div>\n                        <p class=\"qrcode-tips\">请使用APP扫码登录</p>\n                        <a id=\"refreshQrCode\" style=\"font-size: 12px; color: #409eff; cursor: pointer\">刷新二维码</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"zd-foot\" style=\"z-index: -2\">\n        <div class=\"zd-nav\">\n            <em>服务热线：400-080-0526</em>\n\n            <em><a href=\"https://beian.miit.gov.cn/#/Integrated/index\" target=\"_blank\" style=\"color: blue\">闽ICP备19006529号</a></em>\n            <p>\n                为了更好的操作体验，建议使用：谷歌浏览器、360浏览器极速模式、IE9.0或以上版本浏览器\n            </p>\n        </div>\n    </div>\n\n    <div id=\"agentUrl\" style=\"position: fixed;bottom: 10%;right: 20px;cursor: pointer;z-index: -1\">\n        <img title=\"至道客服\" src=\"/public/images/custom_service.png\" style=\"height: 80px;\">\n    </div>\n</div>\n\n<script src=\"/lib/lunbo/js/luobo.js\"></script>\n<script src=\"/lib/lunbo/js/swiper-luobo.js\"></script>\n<script src=\"/lib/jQuery/jquery.min.js\"></script>\n\n<script src=\"/lib/jquery_form/jquery.form.min.js\"></script>\n<script src=\"/layui/modules/layer.js\"></script>\n<script src=\"/lib/jsencrypt/jsencrypt.min.js\"></script>\n<script src=\"/lib/jquery.enplaceholder.js\"></script>\n<script src=\"/public/js/common.js?v=2.0.18\"></script>\n\n<script>\n    var swiper = new Swiper('.swiper-container', {\n        pagination: '.swiper-pagination',\n        paginationClickable: true,\n        spaceBetween: 1,\n        centeredSlides: true,\n        autoplay: 5000,\n        autoplayDisableOnInteraction: false\n    });\n\n    $(function () {\n        $('input:text:first').focus(); //把焦点放在第一个文本框\n        var $userName = $(\"#userName\");\n        var $password = $(\"#password\");\n        var $captcha = $(\"#captcha\");\n        var interval;\n\n        setTimeout(function () {\n            $userName.val(\"\");\n            $password.val(\"\");\n        }, 50);\n\n        // 切换登录标签\n        function switchTab(tabName) {\n            layer.closeAll();\n\n            // 切换标签样式\n            document.querySelectorAll('.login-tab').forEach(tab => {\n                tab.classList.remove('active');\n                if (tab.dataset.tab === tabName) {\n                    tab.classList.add('active');\n                }\n            });\n            // 切换面板显示\n            document.querySelectorAll('.login-panel').forEach(panel => {\n                panel.classList.remove('active');\n            });\n            document.getElementById(`${tabName}-panel`).classList.add('active');\n\n            //扫码登录事件\n            if (tabName === \"qrcode\") {\n                var uniqueId = getUniqueDeviceId()\n\n                updateQrCode();\n\n                $(\"#refreshQrCode\").off(\"click\").on(\"click\", function () {\n                    updateQrCode();\n                });\n\n                function updateQrCode() {\n                    clearInterval(interval);\n\n                    ajaxReq(\"/login/getQrCodeKey\", {}, function (ret) {\n                        $(\"#loginQrCode\").attr(\"src\", \"/login/getLoginQr?id=\" + ret.id);\n\n                        interval = setInterval(function () {\n                            $.ajax(\"/login/checkQrLogin\", {\n                                type: \"POST\",\n                                cache: false,\n                                dataType: \"json\",\n                                data: {uuid: ret.id, uniqueId: uniqueId},\n                                success: function (rs) {\n                                    if (rs.isOk) {\n                                        clearInterval(interval);\n\n                                        if (rs.status == 1) {\n                                            showRespOK(\"登录成功！\");\n                                            go_url(rs.url);\n                                        }\n                                    }\n                                },\n                                error: function (rs) {\n                                    clearInterval(interval);\n                                    showRespFail(\"扫码登录失败，请刷新重试！\");\n                                }\n                            });\n                        }, 2500);\n                    });\n                }\n            } else {\n                if (interval != null) {\n                    clearInterval(interval);\n                }\n            }\n        }\n\n        // 绑定标签点击事件\n        document.querySelectorAll('.login-tab').forEach(tab => {\n            tab.addEventListener('click', () => {\n                switchTab(tab.dataset.tab);\n            });\n        });\n\n        var encrypt = new JSEncrypt();\n        encrypt.setPublicKey(\"MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCWuhgriWbHIbPCQyHmablwQSyItcLyKlQU/0ydXkvU4KJtEExNmuXS0xdoVLBRGxNO5f2u2MkNGzJrFhSpVL68Qc0knhWofzs+BdtpSF4nMi7BteOvOKi0OkvhhCBcHL71Vk8UXOsaKDZkZ3lCBVQHpSA4+s6pi9xIeF93jz6pGwIDAQAB\");\n        var $btnLoginId = $(\"#btnLoginId\").off(\"click\").on(\"click\", function () {\n            layer.closeAll();\n\n            if (!$userName.val()) {\n                showTip(\"请输入账号\", \"userName\");\n                $userName.focus();\n                return;\n            }\n\n            if (!$password.val()) {\n                showTip(\"请输入密码\", \"password\");\n                $password.focus();\n                return;\n            }\n\n            if (!$captcha.val()) {\n                showTip(\"请输入验证码\", 'captcha');\n                $captcha.focus();\n                return;\n            }\n            var uniqueId = getUniqueDeviceId()\n            var identification = encrypt.encrypt(JSON.stringify({userName: $userName.val(), password: $password.val()}));\n            var para = {\n                captcha: $captcha.val(),\n                identification: identification,\n                uniqueId: uniqueId,\n                priorityId: localStorage[\"priorityId\"]\n            };\n\n            postReq(\"/login/doLogin\", para, function (ret) {\n                sessionStorage[\"zd_edu_token\"] = ret.token;\n                if (ret.inSelectCourse) {\n                    location.href = ret.returnUrl;\n                } else {\n                    var search = location.search;\n                    var keyword = \"returnUrl=\";\n                    var indexOf = search.indexOf(keyword);\n                    if (indexOf > 0) {\n                        var nextEqualIndexOf = search.indexOf(\"&\", indexOf + keyword.length);\n                        var returnUrl = nextEqualIndexOf > 0 ? search.substring(indexOf + keyword.length, nextEqualIndexOf) : search.substring(indexOf + keyword.length);\n                        search = nextEqualIndexOf > 0 ? (search.substring(0, indexOf) + search.substring(nextEqualIndexOf + 1)) : search.substring(0, indexOf);\n                        if ((returnUrl.indexOf(\"http://\") === 0 || returnUrl.indexOf(\"https://\") === 0) && returnUrl.indexOf(window.location.origin) !== 0) {\n                            location.href = \"/admin.html#/desk\";\n                        } else {\n                            location.href = returnUrl + (search === '?' ? '' : search);\n                        }\n                    } else {\n                        location.href = \"/admin.html\" + (location.search || \"\") + (location.hash || \"#/desk\");\n                    }\n                }\n            }, function (ret) {\n                showRespFail(ret.msg);\n                updateCaptcha();\n\n                if (ret.captchaMsg) {\n                    showTip(ret.captchaMsg, 'captcha');\n                }\n            });\n        });\n\n\n        var $inp = $('input'); //所有的input元素\n        $inp.keypress(function (e) { //这里给function一个事件参数命名为e，叫event也行，随意的，e就是IE窗口发生的事件。\n            var key = e.which; //e.which是按键的值\n            if (key == 13) {\n                let listOf = $('.login-tab.active');\n                let tabName = listOf.data(\"tab\");\n                if (tabName === \"sms\") {\n                    $(\"#btnSmsLoginId\").trigger(\"click\");\n                } else if (tabName === \"account\") {\n                    $btnLoginId.trigger(\"click\");\n                }\n            }\n        });\n\n        $inp.placeholderForIE();\n\n        showMouseTipCodeTop('huawei_icon', '<img style=\"width:150px;height:150px;margin-top: 5px;\" src=\"/huaweiQrcode\"/>');\n        showMouseTipCodeTop('ohos_icon', '<img style=\"width:150px;height:150px;margin-top: 5px;\" src=\"/ohosQrcode\"/>');\n        showMouseTipCodeTop('android_icon', '<img style=\"width:150px;height:150px;margin-top: 5px;\" src=\"/apkQrcode\"/>');\n        showMouseTipCodeTop(\"ios_icon\", '<img style=\"width:150px;height:150px;margin-top: 5px;\" src=\"/iosQrcode\"/>');\n        showMouseTipCodeTop(\"wx_icon\", '<img style=\"width:150px;height:150px;margin-top: 5px;\" src=\"/wcQrcode\"/>');\n\n        $(\"#viewPassword\").on(\"mousedown\", function () {\n            $password.attr(\"type\", \"text\");\n            $(this).find(\"i\").addClass(\"fa-eye\").removeClass(\"fa-eye-slash\");\n        }).on(\"mouseup\", function () {\n            $password.attr(\"type\", \"password\");\n            $(this).find(\"i\").removeClass(\"fa-eye\").addClass(\"fa-eye-slash\");\n        });\n\n        const $clearText = $(\".clearText\");\n        $clearText.on(\"click\", function () {\n            let $find = $(this).parent().find(\"input\");\n            $find.val(\"\");\n            $find.focus();\n        });\n\n        $(\"#agentUrl\").on(\"click\", function () {\n            var $element = null;\n            var isMobile = $(window).width() < 800;\n            layer.open({\n                type: 2,\n                maxmin: true,\n                area: isMobile ? ['100%', '100%'] : ['800px', '90%'],\n                title: '<b style=\"font-size: 20px;\">至道客服</b>',\n                content: [\"https://www.zhidao.fj.cn/cozeChat.html?areaId=0\", 'no'], //no是不想让iframe出现滚动条\n                success: function (layero, index) {\n                    $element = layero;\n                    calcHeight();\n                    window.addEventListener('resize', calcHeight);\n                },\n                resizing: function (layero) {\n                    calcHeight();\n                },\n                full: function () {\n                    calcHeight();\n                },\n                restore: function () {\n                    calcHeight();\n                },\n                end: function () {\n                    window.removeEventListener('resize', calcHeight);\n                }\n            });\n\n            function calcHeight() {\n                $element.find(\"iframe\").height($element.height() - 50);\n            }\n        });\n\n        let countdown = 60;\n        const sendCodeBtn = document.getElementById('sendCodeBtn');\n        sendCodeBtn.addEventListener('click', () => {\n            const phoneInput = document.querySelector('#sms-panel #userMobile');\n            if (!/^1[3-9]\\d{9}$/.test(phoneInput.value)) {\n                showTip('请输入正确的手机号', \"userMobile\");\n                return;\n            }\n            postReq(\"/login/getLoginSmsCodeByMobile\", {mobile: phoneInput.value}, function (ret) {\n                showRespOK(ret.msg);\n                // 开始倒计时\n                sendCodeBtn.disabled = true;\n                sendCodeBtn.textContent = `${countdown}s后重新获取`;\n                const timer = setInterval(() => {\n                    countdown--;\n                    sendCodeBtn.textContent = `${countdown}s后重新获取`;\n                    if (countdown <= 0) {\n                        clearInterval(timer);\n                        sendCodeBtn.disabled = false;\n                        sendCodeBtn.textContent = '获取验证码';\n                        countdown = 60;\n                    }\n                }, 1000);\n            });\n        });\n\n        $(\"#btnSmsLoginId\").on(\"click\", function () {\n            layer.closeAll();\n            let $userMobile = $(\"#userMobile\");\n            let $userMobileCode = $(\"#userMobileCode\");\n\n            if (!hasText($userMobile.val())) {\n                showTip(\"请输入手机号\", \"userMobile\");\n                $userName.focus();\n                return;\n            }\n            if (!hasText($userMobileCode.val())) {\n                showTip(\"请输入验证码\", \"userMobileCode\");\n                $password.focus();\n                return;\n            }\n            var uniqueId = getUniqueDeviceId()\n            var identification = encrypt.encrypt(JSON.stringify({mobile: $.trim($userMobile.val()), smsCode: $.trim($userMobileCode.val())}));\n            var para = {\n                identification: identification,\n                uniqueId: uniqueId,\n                priorityId: localStorage[\"priorityId\"]\n            };\n\n            postReq(\"/login/doSmsLogin\", para, function (ret) {\n                if (ret[\"selAccount\"]) {\n                    var content = '<div style=\"padding: 20px;\">';\n                    content += '<div class=\"form-group\">';\n                    content += '<div class=\"radio\">';\n                    $.each(ret.list, function (i, item) {\n                        var checked = (i === 0) ? \"checked\" : \"\";\n                        content += '<div><label style=\"margin-left: 10px;\"><input type=\"radio\" name=\"selUserAccount\" value=\"' + item.value + '\" ' + checked + '>' + item.text + '</label></div><br>';\n                    });\n                    content += '</div>';\n                    content += '</div>';\n                    content += '</div>';\n\n                    layer.open({\n                        type: 1,\n                        title: \"该手机号关联多个账号，请选择账号登录\",\n                        btn: [\"确定\"],\n                        area: ['auto', 'auto'],\n                        content: content,\n                        yes: function (index) {\n                            var account = $('input:radio[name=\"selUserAccount\"]:checked').val();\n                            var identification2 = encrypt.encrypt(JSON.stringify({mobile: $.trim($userMobile.val()), smsCode: $.trim($userMobileCode.val()), account: account}));\n                            var para2 = {\n                                identification: identification2,\n                                uniqueId: uniqueId,\n                                priorityId: localStorage[\"priorityId\"]\n                            };\n                            postReq(\"/login/afterSmsLogin\", para2, function (ret2) {\n                                sessionStorage[\"zd_edu_token\"] = ret2.token;\n                                var search = location.search;\n                                var keyword = \"returnUrl=\";\n                                var indexOf = search.indexOf(keyword);\n                                if (indexOf > 0) {\n                                    var nextEqualIndexOf = search.indexOf(\"&\", indexOf + keyword.length);\n                                    var returnUrl = nextEqualIndexOf > 0 ? search.substring(indexOf + keyword.length, nextEqualIndexOf) : search.substring(indexOf + keyword.length);\n                                    search = nextEqualIndexOf > 0 ? (search.substring(0, indexOf) + search.substring(nextEqualIndexOf + 1)) : search.substring(0, indexOf);\n                                    if ((returnUrl.indexOf(\"http://\") === 0 || returnUrl.indexOf(\"https://\") === 0) && returnUrl.indexOf(window.location.origin) !== 0) {\n                                        location.href = \"/admin.html#/desk\";\n                                    } else {\n                                        location.href = returnUrl + (search === '?' ? '' : search);\n                                    }\n                                } else {\n                                    location.href = \"/admin.html\" + (location.search || \"\") + (location.hash || \"#/desk\");\n                                }\n                            });\n                            layer.close(index);\n                        }\n                    });\n                } else {\n                    sessionStorage[\"zd_edu_token\"] = ret.token;\n                    var search = location.search;\n                    var keyword = \"returnUrl=\";\n                    var indexOf = search.indexOf(keyword);\n                    if (indexOf > 0) {\n                        var nextEqualIndexOf = search.indexOf(\"&\", indexOf + keyword.length);\n                        var returnUrl = nextEqualIndexOf > 0 ? search.substring(indexOf + keyword.length, nextEqualIndexOf) : search.substring(indexOf + keyword.length);\n                        search = nextEqualIndexOf > 0 ? (search.substring(0, indexOf) + search.substring(nextEqualIndexOf + 1)) : search.substring(0, indexOf);\n                        if ((returnUrl.indexOf(\"http://\") === 0 || returnUrl.indexOf(\"https://\") === 0) && returnUrl.indexOf(window.location.origin) !== 0) {\n                            location.href = \"/admin.html#/desk\";\n                        } else {\n                            location.href = returnUrl + (search === '?' ? '' : search);\n                        }\n                    } else {\n                        location.href = \"/admin.html\" + (location.search || \"\") + (location.hash || \"#/desk\");\n                    }\n                }\n            }, function (ret) {\n                showRespFail(ret.msg);\n            });\n        });\n    });\n\n    function showMouseTipCodeTop(objText, message) {\n        var showIndex = null;\n        var $showActHelp = $(\"#\" + objText);\n        $showActHelp.unbind();\n        $showActHelp.mouseenter(function () {\n            showIndex = layer.tips(message, '#' + objText, {\n                tips: [1, '#eee'],\n                time: 200000,\n                maxWidth: 600\n            });\n        });\n        $showActHelp.mouseleave(function () {\n            layer.close(showIndex);\n        });\n    }\n\n    function updateCaptcha() {\n        var $captcha = $(\"#captcha\");\n        $(\".check-code\").find(\"img\").attr(\"src\", \"/login/captcha?v=\" + Math.random());\n        $captcha.val(\"\").focus();\n    }\n\n    function openQrLogin() {\n        var content = \"<div style='padding: 20px;'>\";\n        content += \"<div style='text-align: center;margin-bottom: 10px;'><span style='font-size: 28px;'><b>APP扫码登录</b></span></div>\";\n        content += \"<div style='text-align: center;margin-bottom: 10px;'><img id='loginQrCode'></div>\";\n        content += \"<div style='text-align: center;margin-bottom: 10px;'><a style='cursor: pointer;' id='refreshQrCode'>刷新</a></div>\";\n        content += \"</div>\";\n\n        var interval;\n        layer.open({\n            type: 1,\n            title: false,\n            area: ['300px', '420px'],\n            content: content,\n            shadeClose: true,\n            success: function () {\n                var uniqueId = getUniqueDeviceId()\n\n                updateQrCode();\n\n                $(\"#refreshQrCode\").off(\"click\").on(\"click\", function () {\n                    updateQrCode();\n                });\n\n                function updateQrCode() {\n                    clearInterval(interval);\n\n                    ajaxReq(\"/login/getQrCodeKey\", {}, function (ret) {\n                        $(\"#loginQrCode\").attr(\"src\", \"/login/getLoginQr?id=\" + ret.id);\n\n                        interval = setInterval(function () {\n                            $.ajax(\"/login/checkQrLogin\", {\n                                type: \"POST\",\n                                cache: false,\n                                dataType: \"json\",\n                                data: {uuid: ret.id, uniqueId: uniqueId},\n                                success: function (rs) {\n                                    if (rs.isOk) {\n                                        clearInterval(interval);\n\n                                        if (rs.status == 1) {\n                                            showRespOK(\"登录成功！\");\n                                            go_url(rs.url);\n                                        }\n                                    }\n                                },\n                                error: function (rs) {\n                                    clearInterval(interval);\n                                    showRespFail(\"扫码登录失败，请刷新重试！\");\n                                }\n                            });\n                        }, 2500);\n                    });\n                }\n            },\n            cancel: function () {\n                clearInterval(interval);\n            }\n        });\n    }\n</script>\n</body>\n</html>\n"
          },
