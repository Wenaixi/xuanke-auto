          "content": {
            "size": 7429,
            "mimeType": "text/html",
            "text": "<section class=\"content-header\">\n    <ol class=\"breadcrumb\">\n        <li><a href=\"javascript:;\"><i class=\"breadcrumb_icon\"></i>研究性学习</a></li>\n        <li class=\"active\">研究性学习申报</li>\n    </ol>\n</section>\n<section class=\"content\" style=\"margin-left:15px;margin-right:15px;\">\n    <div class=\"row\">\n        <div class=\"col-sm-12 box box-primary search-box-div-one\">\n            <div class=\"form-inline\">\n                <label class=\"control-label\">学年学期:</label>\n                <select id=\"gradeYearTerm\" class=\"form-control\">\n                    <option value=\"\">全部</option>\n                </select>\n                <a id=\"searchStudyPublish\" class=\"btn btn-primary\">\n                    <i class=\"glyphicon glyphicon-search\"></i> 查询\n                </a>\n            </div>\n        </div>\n        <div class=\"col-sm-12 box box-primary\">\n            <table id=\"studyPublishTable\" style=\"white-space:nowrap; overflow:hidden;\"></table>\n        </div>\n    </div>\n</section>\n\n<!--申请研究性学习立项-->\n<script type=\"text/html\" id=\"addStudyProjectsPopup\">\n    <form role=\"form\" id=\"addStudyProjectsForm\">\n        <div class=\"box-body form-popup\">\n            <div class=\"row\">\n                <input type=\"hidden\" id=\"study_publish_id\" name=\"study_publish_id\">\n                <div class=\"col-md-12\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">研究性学习课题<i class=\"required-sign\">*</i></label>\n                        <input type=\"text\" class=\"form-control\" id=\"study_title\" name=\"study_title\" placeholder=\"请填写研究性学习课题\" autocomplete=\"off\" maxlength=\"45\">\n                        <div class=\"input-group\" id=\"appointProject\" style=\"display: none\">\n                            <input type=\"hidden\" id=\"publish_project_id\" name=\"publish_project_id\">\n                            <input type=\"text\" id=\"publish_project_name\" name=\"study_title\" placeholder=\"请填写研究性学习课题\" class=\"form-control\" readonly=\"\">\n                            <div class=\"input-group-btn\">\n                                <a class=\"btn btn-default\" style=\"cursor: default\"><input id=\"define_study_title\" type=\"checkbox\" style=\"margin: 0; cursor: pointer\" lay-tips=\"自定义填写课题\"> 自定义</a>\n                                <button type=\"button\" class=\"btn btn-default\" id=\"selPublishProject\">从指定课题选择</button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-md-12\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">课题负责人</label>\n                        <input type=\"hidden\" id=\"study_master_id\" name=\"study_master_id\">\n                        <input type=\"text\" class=\"form-control\" id=\"study_master_name\" name=\"study_master_name\" placeholder=\"\" disabled>\n                    </div>\n                </div>\n                <div class=\"col-md-12\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">课题指导老师<i class=\"required-sign\">*</i></label>\n                        <div class=\"input-group\">\n                            <input type=\"hidden\" id=\"teacher_id\" name=\"teacher_id\">\n                            <input type=\"text\" id=\"teacher_name\" name=\"teacher_name\" placeholder=\"请选择课题指导老师\" class=\"form-control\" readonly=\"\">\n                            <div class=\"input-group-btn\">\n                                <button type=\"button\" class=\"btn btn-default\" id=\"selTeacher\">选择</button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-md-12\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">课题组成员</label>\n                        <div class=\"input-group\">\n                            <input type=\"hidden\" id=\"member_id_list\" name=\"member_id_list\">\n                            <input type=\"text\" id=\"member_name_list\" name=\"member_name_list\" placeholder=\"请选择课题组成员\" class=\"form-control\" readonly=\"\">\n                            <div class=\"input-group-btn\">\n                                <button type=\"button\" class=\"btn btn-default\" id=\"selMember\">选择</button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-md-12\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">课题申报文件<i class=\"required-sign\">*</i></label>\n                        <div class=\"input-group\">\n                            <input type=\"hidden\" id=\"apply_file\" name=\"apply_file\">\n                            <input type=\"text\" id=\"apply_file_name\" name=\"apply_file_name\" placeholder=\"请上传课题申报文件\" class=\"form-control\" readonly=\"\">\n                            <div class=\"input-group-btn\">\n                                <button type=\"button\" class=\"btn btn-default\" id=\"selFile\">选择</button>\n                            </div>\n                        </div>\n                        <!--上传文件-->\n                        <div style=\"display: none\" class=\"form-group\" id=\"applyFileUpload\">\n                            <div class=\"col-md-4\" id=\"apply_common_file\">选择文件</div>\n                            <div class=\"col-md-8 uploader-list\"></div>\n                            <div style=\"display:none\" class=\"UploadhiddenInput\"></div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-md-12\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">课题简要说明</label>\n                        <textarea class=\"form-control\" id=\"description\" name=\"description\" placeholder=\"课题简要说明\" maxlength=\"500\"></textarea>\n                    </div>\n                </div>\n                <div class=\"col-md-12\" id=\"apply_date_div\">\n                    <div class=\"form-group\">\n                        <label class=\"control-label\">申报日期<i class=\"required-sign\">*</i></label>\n                        <input type=\"text\" id=\"apply_date\" name=\"apply_date\" placeholder=\"请填写申报日期\" class=\"form-control\" autocomplete=\"off\"\n                               onFocus=\"WdatePicker({dateFmt:'yyyy-MM-dd',startDate:'%y-%M-%d'})\"/>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </form>\n</script>\n\n<script type=\"text/html\" id=\"applyAppointProjectPopup\">\n    <div style=\"margin: 0 15px 0 15px\">\n        <div id=\"applyAppointProjectToolbar\">\n            <div class=\"form-inline\">\n                <span class=\"form-control\">当前共有<b style=\"color: red\" id=\"totalNum\">0</b>个课题\n                    ，您可报名<b style=\"color: red\" id=\"canApplyNum\">0</b>个课题\n                    ，您已经报名<b style=\"color: red\" id=\"stuApplyNum\">0</b>个课题</span>\n            </div>\n        </div>\n        <table id=\"applyAppointProjectTable\" style=\"white-space:nowrap; overflow:hidden\"></table>\n    </div>\n</script>\n<script>\n    layui.use([], function () {\n        const path = exportViewPath();\n        layui.use(path, layui.factory(path));\n    });\n</script>"
          },
